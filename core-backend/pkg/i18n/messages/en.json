  "email": {
    "welcome": {
      "subject": "Welcome to Adisu Serategna",
      "template": "<div style='font-family:Segoe UI,Arial,sans-serif;background:#f4f7fb;padding:24px'><div style='max-width:620px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb'><div style='background:#0f4c81;color:#ffffff;padding:18px 24px;font-size:20px;font-weight:700'>Adisu Serategna</div><div style='padding:24px;color:#111827;line-height:1.6'><p style='margin:0 0 12px'>Hi {{.firstName}},</p><p style='margin:0 0 12px'>Welcome to Adisu Serategna. We're happy to have you with us.</p><p style='margin:0'>Best regards,<br/>Adisu Serategna Team</p></div></div></div>"
    },
    "verification": {
      "subject": "Verify your email",
      "template": "<div style='font-family:Segoe UI,Arial,sans-serif;background:#f4f7fb;padding:24px'><div style='max-width:620px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb'><div style='background:#0f4c81;color:#ffffff;padding:18px 24px;font-size:20px;font-weight:700'>Adisu Serategna</div><div style='padding:24px;color:#111827;line-height:1.6'><p style='margin:0 0 12px'>Hi {{.firstName}},</p><p style='margin:0 0 12px'>Use the verification code below to activate your account:</p><p style='margin:16px 0;font-size:28px;font-weight:700;letter-spacing:4px'>{{.otpCode}}</p><p style='margin:0 0 12px'>This code expires in {{.expiresMinutes}} minutes.</p><p style='margin:0'>If you did not request this, please ignore this email.</p></div></div></div>"
    },
    "adminCredentials": {
      "subject": "Your admin account credentials",
      "template": "<div style='font-family:Segoe UI,Arial,sans-serif;background:#f4f7fb;padding:24px'><div style='max-width:620px;margin:0 auto;background:#ffffff;border-radius:12px;overflow:hidden;border:1px solid #e5e7eb'><div style='background:#0f4c81;color:#ffffff;padding:18px 24px;font-size:20px;font-weight:700'>Adisu Serategna</div><div style='padding:24px;color:#111827;line-height:1.6'><p style='margin:0 0 12px'>Hi {{.firstName}} {{.lastName}},</p><p style='margin:0 0 12px'>Your admin account has been created. Use the credentials below to sign in:</p><p style='margin:12px 0'><strong>Email:</strong> {{.email}}</p><p style='margin:12px 0'><strong>Password:</strong> {{.password}}</p><p style='margin:16px 0 0'>Please change your password after your first login.</p></div></div></div>"
    }
